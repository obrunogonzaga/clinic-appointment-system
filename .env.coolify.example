# ---------------------------
# Core infrastructure secrets
# ---------------------------

# MongoDB credentials (required if running mongodb service)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_INITDB_DATABASE=clinic_db

# Application database connection (referenced by backend/worker)
MONGODB_URL=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/
DATABASE_NAME=clinic_db

# Redis configuration
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_DB=0

# MinIO credentials (adjust if using external S3 provider)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me
MINIO_BROWSER_REDIRECT_URL=
MINIO_SERVER_URL=
MINIO_BUCKET_NAME=patient-docs
S3_ENDPOINT=http://minio:9000

# ---------------------------
# Backend / Worker settings
# ---------------------------

APP_NAME=Clinic Appointment System API
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
PORT=8000
DATABASE_NAME=clinic_db
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SECRET_KEY=replace-me
JWT_SECRET_KEY=replace-me-as-well
ALLOW_ADMIN_REGISTRATION=false
MAX_ADMIN_USERS=5
ADMIN_EMAIL_WHITELIST=admin@example.com
CORS_ORIGINS=["https://your-frontend-domain.com"]
FRONTEND_URL=https://your-frontend-domain.com
API_URL=https://api.your-domain.com
# BACKEND_URL deve apontar para o serviço interno dentro da rede Docker
BACKEND_URL=http://backend:8000

# Background jobs / normalization
ADDRESS_NORMALIZATION_ENABLED=true
DOCUMENT_NORMALIZATION_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Cloudflare R2 (optional if using R2 instead of MinIO)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PATIENT_DOCS=patient-docs
R2_PRESIGN_TTL_SECONDS=600

# Email/SMS integrations (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ---------------------------
# Chatwoot - Customer Support
# ---------------------------

# PostgreSQL for Chatwoot
POSTGRES_DB=chatwoot_production
POSTGRES_USER=chatwoot
POSTGRES_PASSWORD=change-me-strong-password

# Chatwoot application
CHATWOOT_DB_NAME=chatwoot_production
CHATWOOT_DB_USER=chatwoot
CHATWOOT_DB_PASSWORD=change-me-strong-password
CHATWOOT_SECRET_KEY_BASE=generate-with-bundle-exec-rake-secret-minimum-127-chars
CHATWOOT_FRONTEND_URL=https://chat.your-domain.com

# Chatwoot optional settings
RAILS_ENV=production
INSTALLATION_ENV=docker
ACTIVE_STORAGE_SERVICE=local
RAILS_LOG_TO_STDOUT=true
USE_INBOX_AVATAR_FOR_BOT=true

# Chatwoot SMTP (reuse same SMTP settings above or configure separately)
MAILER_SENDER_EMAIL=${SMTP_FROM_EMAIL}
SMTP_ADDRESS=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT}
SMTP_DOMAIN=your-domain.com
SMTP_USERNAME=${SMTP_USERNAME}
SMTP_PASSWORD=${SMTP_PASSWORD}
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
